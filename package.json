{
  "name": "wtc-gl-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "pnpm -r run build",
    "lint": "eslint --fix --ext .ts,.tsx --ignore-path .gitignore ./packages/*/src/**/*",
    "preview": "vite preview --config vite.site.config.js",
    "document": "typedoc --entryPointStrategy Expand",
    "build:site": "pnpm run document && vite build --config vite.site.config.js && cp -r docs dist-site/demos/docs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "~7.18.0",
    "@typescript-eslint/parser": "~7.18.0",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "~8.10.0",
    "husky": "~9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "typedoc": "~0.28.19",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-glsl": "~1.6.0",
    "wtc-gl": "workspace:*"
  },
  "lint-staged": {
    "packages/*/src/**/*.{ts,tsx,js}": "eslint --fix",
    "packages/*/src/**/*": "prettier -w -u"
  }
}
