{
  "name": "wtc-gl-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter wtc-gl-site run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint --fix --ext .ts,.tsx --ignore-path .gitignore ./packages/*/src/**/* ./packages/*/test/**/*",
    "preview": "pnpm --filter wtc-gl-site run preview",
    "document": "typedoc --entryPointStrategy Expand",
    "build:site": "pnpm run document && pnpm --filter wtc-gl-site run build && cp -r docs packages/site/dist-site/demos/docs",
    "check": "eslint --ext .ts,.tsx --ignore-path .gitignore ./packages/*/src/**/* ./packages/*/test/**/* && pnpm run build",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "~7.18.0",
    "@typescript-eslint/parser": "~7.18.0",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "~8.10.0",
    "husky": "~9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "typedoc": "~0.28.19",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "packages/*/{src,test}/**/*.{ts,tsx,js}": "eslint --fix",
    "packages/*/{src,test}/**/*": "prettier -w -u"
  }
}
