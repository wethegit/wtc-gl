{
  "name": "@wethegit/react-wtc-gl",
  "version": "0.2.0",
  "description": "React components and hooks for wtc-gl recipes.",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/react-wtc-gl.cjs",
  "module": "./dist/react-wtc-gl.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/react-wtc-gl.js"
    },
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/react-wtc-gl.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist; tsc && vite build",
    "watch": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "wtc-gl": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "~5.0.0",
    "wtc-gl": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wethegit/wtc-gl.git"
  },
  "homepage": "https://github.com/wethegit/wtc-gl#readme",
  "author": "Liam Egan <liam@wethecollective.com> (http://wethecollective.com)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
