{
  "name": "wtc-gl",
  "version": "1.5.0",
  "description": "Typescript simple Web GL library.",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/wtc-gl.umd.cjs",
  "module": "./dist/wtc-gl.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/wtc-gl.js"
    },
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/wtc-gl.umd.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist; tsc && vite build",
    "watch": "vite build --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/webgl2": "0.0.12",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "~5.1.2",
    "vite-plugin-glsl": "~1.6.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "wtc-math": "^1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wethegit/wtc-gl.git"
  },
  "keywords": [],
  "homepage": "https://github.com/wethegit/wtc-gl#readme",
  "author": "Liam Egan <liam@wethecollective.com> (http://wethecollective.com)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
