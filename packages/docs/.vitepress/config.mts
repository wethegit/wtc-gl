import { readFileSync, existsSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import { defineConfig, type DefaultTheme } from 'vitepress'
import type { Plugin } from 'vite'

const here = (path: string) => fileURLToPath(new URL(path, import.meta.url))

// wtc-gl imports its shaders as strings. vite-plugin-glsl does that for the
// site, but on VitePress's Vite 5 it turns every module into a string, and
// wtc-gl's shaders don't use its #include, so a plain loader does.
const shaders: Plugin = {
  name: 'shaders-as-strings',
  enforce: 'pre',
  transform(code, id) {
    if (/\.(glsl|vert|frag)$/.test(id.split('?')[0])) {
      return { code: `export default ${JSON.stringify(code)}`, map: null }
    }
  }
}

const pkg = JSON.parse(readFileSync(here('../../wtc-gl/package.json'), 'utf8'))

// The API sidebars are generated by TypeDoc (`pnpm run api`) alongside the
// API pages. Missing before the first run, so read them leniently.
const apiSidebar = (name: string): DefaultTheme.SidebarItem[] => {
  const file = here(`../api/${name}/typedoc-sidebar.json`)
  return existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : []
}

