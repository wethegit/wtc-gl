import { readFileSync, existsSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import { defineConfig, type DefaultTheme } from 'vitepress'
import type { Plugin } from 'vite'

const here = (path: string) => fileURLToPath(new URL(path, import.meta.url))

// wtc-gl imports its shaders as strings. vite-plugin-glsl does that for the
// site, but on VitePress's Vite 5 it turns every module into a string, and
// wtc-gl's shaders don't use its #include, so a plain loader does.
const shaders: Plugin = {
  name: 'shaders-as-strings',
  enforce: 'pre',
  transform(code, id) {
    if (/\.(glsl|vert|frag)$/.test(id.split('?')[0])) {
      return { code: `export default ${JSON.stringify(code)}`, map: null }
    }
  }
}

const pkg = JSON.parse(readFileSync(here('../../wtc-gl/package.json'), 'utf8'))

// The API sidebars are generated by TypeDoc (`pnpm run api`) alongside the
// API pages. Missing before the first run, so read them leniently.
const apiSidebar = (name: string): DefaultTheme.SidebarItem[] => {
  const file = here(`../api/${name}/typedoc-sidebar.json`)
  return existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : []
}

const guide: DefaultTheme.SidebarItem[] = [
  {
    text: 'Getting started',
    items: [
      { text: 'Introduction', link: '/' },
      { text: 'Installation', link: '/getting-started/installation' },
      { text: 'Your first shader', link: '/getting-started/first-shader' }
    ]
  }
]

const api: DefaultTheme.SidebarItem[] = [
  {
    text: 'wtc-gl',
    items: [{ text: 'Overview', link: '/api/wtc-gl/' }, ...apiSidebar('wtc-gl')]
  },
  {
    text: 'react-wtc-gl',
    items: [{ text: 'Overview', link: '/api/react/' }, ...apiSidebar('react')]
  },
  {
    text: 'wtc-math',
    items: [{ text: 'Vectors and matrices', link: '/api/wtc-math' }]
  }
]

export default defineConfig({
  title: 'wtc-gl',
  description:
    'A small WebGL2 library for shader-driven sites: scene graph, geometry, lines, lighting, loading and scroll-synced scenes.',
  base: '/wtc-gl/docs/',
  cleanUrls: true,
  lastUpdated: false,
  // The API pages link to sources on GitHub and to each other; everything
  // else must resolve
  ignoreDeadLinks: [/^https?:\/\//],
  head: [['link', { rel: 'icon', href: '/wtc-gl/docs/favicon.svg' }]],

  markdown: {
    // Code blocks are dark in both themes, as on tailwindcss.com
    theme: { light: 'github-dark', dark: 'github-dark' },
    lineNumbers: false
  },

  themeConfig: {
    logo: { src: '/logo.svg', alt: '' },
    siteTitle: 'wtc-gl',
    nav: [
      { text: 'Docs', link: '/', activeMatch: '^/(?!api)' },
      { text: 'API', link: '/api/wtc-gl/', activeMatch: '^/api/' },
      { text: 'Demos', link: 'https://wethegit.github.io/wtc-gl/demos/' },
      {
        text: `v${pkg.version}`,
        items: [
          {
            text: 'Changelog',
            link: 'https://github.com/wethegit/wtc-gl/blob/master/packages/wtc-gl/CHANGELOG.md'
          },
          { text: 'npm', link: 'https://www.npmjs.com/package/wtc-gl' }
        ]
      }
    ],
    sidebar: {
      '/api/': api,
      '/': guide
    },
    outline: { level: [2, 3], label: 'On this page' },
    search: { provider: 'local' },
    socialLinks: [
      { icon: 'github', link: 'https://github.com/wethegit/wtc-gl' }
    ],
    editLink: {
      pattern:
        'https://github.com/wethegit/wtc-gl/edit/master/packages/docs/:path',
      text: 'Edit this page on GitHub'
    },
    docFooter: { prev: 'Previous', next: 'Next' }
  },

  vite: {
    plugins: [shaders],
    resolve: {
      // Examples run against the library's source, as the demos do
      alias: {
        'wtc-gl': here('../../wtc-gl/src/index.ts'),
        '@wethegit/react-wtc-gl': here('../../react/src/index.ts')
      }
    },
    optimizeDeps: { exclude: ['manifold-3d'] }
  }
})
